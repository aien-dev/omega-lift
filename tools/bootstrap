#!/bin/sh
# Build the lifter from source on Linux AArch64.
# The parent omega-bridge checkout (pinned in PARENT) supplies the seeded
# compiler omc and the toc translator; nothing else is imported.
# OMEGA_BRIDGE=/path/to/built/omega-bridge reuses an existing checkout
# (read-only); otherwise it is fetched into build/omega-bridge and bootstrapped.
set -eu
cd "$(dirname "$0")/.."
read -r repo pin < PARENT
mkdir -p build
if [ -n "${OMEGA_BRIDGE:-}" ]; then
    bridge=$(realpath -- "$OMEGA_BRIDGE")
else
    bridge=$PWD/build/omega-bridge
    if [ ! -d "$bridge/.git" ]; then git init -q "$bridge"; fi
    if [ "$(git -C "$bridge" rev-parse -q --verify HEAD 2>/dev/null || true)" != "$pin" ]; then
        git -C "$bridge" fetch -q --depth=1 "https://github.com/$repo.git" "$pin"
        git -C "$bridge" checkout -q --detach FETCH_HEAD
    fi
    [ -x "$bridge/build/bootstrap/omc" ] || sh "$bridge/tools/bootstrap.sh"
    [ -x "$bridge/build/bridge" ] || sh "$bridge/tools/build.sh"
fi
[ "$(git -C "$bridge" rev-parse HEAD)" = "$pin" ] || { echo "bootstrap: $bridge is not at $pin" >&2; exit 65; }
omc=$bridge/build/bootstrap/omc
[ "$(sha256sum "$omc" | cut -d' ' -f1)" = 191b776ef98821597c3e30655da6d680a9b66edbc9ceaca3c39c61ea6df098e9 ] || { echo 'bootstrap: omc sha mismatch' >&2; exit 65; }
printf '%s\n' "$bridge" > build/bridge.path
for u in c py; do
    cat src/core.om "src/front_$u.om" > "build/lift$u.om"
    "$omc" < "build/lift$u.om" > "build/lift$u.tmp"
    [ -s "build/lift$u.tmp" ] || { echo "bootstrap: omc rejected build/lift$u.om" >&2; exit 65; }
    chmod +x "build/lift$u.tmp"
    mv "build/lift$u.tmp" "build/lift$u"
done
sha256sum src/core.om src/front_c.om src/front_py.om build/liftc build/liftpy
printf 'lift bootstrap RC=0\n'
